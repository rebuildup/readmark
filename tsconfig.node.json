{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["ES2023"],
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"moduleDetection": "force",
		"verbatimModuleSyntax": true,
		"noEmit": true,
		"isolatedModules": true,
		"skipLibCheck": true,
		"strict": true,
		"types": ["node"]
	},
	"include": ["vite.config.ts", "vitest.config.ts", "biome.json"]
}
